# Todas as variáveis são opcionais; os valores abaixo são os padrões de desenvolvimento.
HABITUS_DATABASE_URL=sqlite:///./habitus.db
# TROCAR em qualquer ambiente que não seja o seu computador:
HABITUS_SECRET_KEY=dev-only-trocar-em-producao-0123456789
HABITUS_TOKEN_MINUTOS=480
HABITUS_UPLOADS_DIR=./uploads
HABITUS_CORS_ORIGINS=http://localhost:5173
# 1 = roda as automações (reset semanal, punições) dentro do processo da API
HABITUS_SCHEDULER=0
